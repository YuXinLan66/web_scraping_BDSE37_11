   "source": [
    "\n",
    "# 指定要儲存的資料夾\n",
    "folder_path = \"project_gutenberg\"\n",
    "os.makedirs(folder_path, exist_ok=True)\n",
    "\n",
    "\n",
    "# 初始化 Selenium WebDriver \n",
    "driver = webdriver.Chrome()\n",
    "\n",
    "try:\n",
    "    for page in list_posts_href:\n",
    "        title = page['title']\n",
    "\n",
    "        link = page['link']\n",
    "        # 取得網頁\n",
    "        url = f\"https://www.gutenberg.org/cache/epub/{link}/pg{link}-images\"\n",
    "        driver.get(url)\n",
    "        safe_title = re.sub(r'[\\\\/:*?\"<>| ]', '_', title)\n",
    "        # 等待 body 元素加載\n",
    "        WebDriverWait(driver, 10).until(EC.presence_of_element_located((By.TAG_NAME, 'body')))\n",
    "\n",
    "        file_path = os.path.join(folder_path, f\"{safe_title}.txt\")\n",
    "        \n",
    "\n",
    "        p_elements = driver.find_elements(By.XPATH, \"/html/body\")\n",
    "\n",
    "        for p in p_elements:\n",
    "            text = p.text.strip()\n",
    "            if \": Chinese\" in text:\n",
    "                # 抓取所有 html/body/p 並排除包含英文字母的段落\n",
    "                body_text = driver.find_element(By.TAG_NAME, \"body\").text\n",
    "                paragraphs = body_text.split('\\n')\n",
    "                chinese_paragraphs = [para.strip() for para in paragraphs if para.strip() and not re.search(r'[a-zA-Z]', para.strip())]\n",
    "\n",
    "                if chinese_paragraphs:\n",
    "                    try:\n",
    "                        with open(file_path, \"w\", encoding=\"utf-8\") as file:\n",
    "                            file.write(\"\\n\".join(chinese_paragraphs))\n",
    "                        print(f\"已將不包含英文字母的 <p> 元素寫入: {file_path}\")\n",
    "                    except OSError as e:  # 捕獲 OSError，Errno 22 是 OSError 的子類\n",
    "                        if e.errno == 22:\n",
    "                            print(f\"跳過創建檔案，標題包含非法字元: {title}\")\n",
    "                        else:\n",
    "                            # 如果是其他 OSError，則重新拋出或處理\n",
    "                            print(f\"創建檔案 {file_path} 時發生其他錯誤: {e}\")\n",
    "                            
    "                else:\n",
    "                        print(f\"在頁面 {page} 的 <body> 下沒有找到不包含英文字母的 <p> 元素。\")\n",
    "                break # 找到包含 \": Chinese\" 的段落後，處理完 body 內容就跳出內層迴圈\n",
    "            else:\n",
    "                continue\n",
    "            # print(f\"在頁面 {page} 沒有找到包含 ': Chinese' 的 <p> 元素。\")\n",
    "\n",
    "        sleep(1)\n",
    "\n",
    "except Exception as e:\n",
    "    print(f\"發生錯誤: {e}\")\n",
    "\n",
    "finally:\n",
    "    driver.quit()"
   ]
  }
